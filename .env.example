# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave empty to run with built-in demo disputes.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# OpenRouter API key (openrouter.ai/keys). Leave empty to use the built-in rules engine.
OPENROUTER_API_KEY=
# Any OpenRouter model with tool calling. openrouter/free picks a free model.
OPENROUTER_MODEL=openrouter/free

# Optional: your shop's refund/shipping policy, used as context for every review.
STORE_POLICY_TEXT=

# Max AI calls per hour (protects your API budget on a public demo).
AI_MAX_CALLS_PER_HOUR=60
# Give up on a slow model after this many milliseconds and use the rules engine.
AI_TIMEOUT_MS=30000

PORT=3000
