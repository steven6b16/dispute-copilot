# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave empty to run with built-in demo disputes.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Anthropic API key (console.anthropic.com). Leave empty to use the built-in rules engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: your shop's refund/shipping policy, used as context for every review.
STORE_POLICY_TEXT=

# Max Claude calls per hour (protects your API budget on a public demo).
AI_MAX_CALLS_PER_HOUR=60

PORT=3000
